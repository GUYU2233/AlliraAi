# Dependencies and generated artifacts belong on the development server.
.venv/
node_modules/
dist/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Credentials and runtime data must never be committed or synchronized as source.
.env
.env.*
!.env.example
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db
*.db-shm
*.db-wal
*.log
.DS_Store

# SSH identities and exported credentials are never source files.
.ssh/
id_rsa*
id_ed25519*
*.pem
*.key
*.p12
*.pfx

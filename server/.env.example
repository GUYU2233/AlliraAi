# Development only. Copy on the remote server, never on the laptop.
ALLIRA_ENVIRONMENT=development
ALLIRA_DATABASE_PATH=/var/lib/allira/dev.sqlite3
# Explicitly disabled, including previously issued developer sessions. No public exposure.
ALLIRA_ALLOW_DEV_AUTH=false
ALLIRA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ALLIRA_SESSION_TTL_SECONDS=86400
# HttpOnly registered-account business session; opt-in, distinct from Bearer/admin/OIDC.
ALLIRA_BROWSER_SESSION_TTL_SECONDS=604800
ALLIRA_REGISTRATION_ENABLED=true
# Logto owns phone OTP/social authentication; Allira is only the OIDC relying party.
ALLIRA_AUTH_BACKEND=oidc
# Remain disabled until actual provider channels and the whole deployment are accepted.
ALLIRA_OIDC_ENABLED=false
ALLIRA_OIDC_SIMULATED=false
# Complete all four values together in protected /etc/allira/identity.env, not here.
# ALLIRA_OIDC_ISSUER_URL=http://127.0.0.1:3001/oidc
# ALLIRA_OIDC_CLIENT_ID=operator-created-confidential-rp-id
# ALLIRA_OIDC_CLIENT_SECRET=configure-only-in-a-protected-server-environment
# ALLIRA_OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/oidc/callback
# HTTP is restricted to explicit loopback ports. Public deployments require HTTPS.
# Fresh OIDC proof plus explicit owner association replaces the old login main entry.
# Legacy password checks are available only inside the dedicated migration transaction.
ALLIRA_LEGACY_REGISTRATION_ENABLED=false
# Kept for isolated legacy compatibility tests, never enabled alongside OIDC.
ALLIRA_SMS_PROVIDER=disabled
ALLIRA_SOCIAL_MODE=disabled
# Upstream official mock channels are maintenance-only; no default/universal OTP.
# See ops/logto/README.md for fixed-version deployment, private files and real-channel limits.
# Diagnostics reads metadata only; the systemd backup task performs snapshots.
ALLIRA_BACKUP_DIRECTORY=/var/lib/allira/backups/automatic
# Separate Logto PG metadata only; SQLite timer does not cover it or protected configuration.
ALLIRA_IDENTITY_BACKUP_DIRECTORY=/var/lib/allira/logto/backups
ALLIRA_PROVIDER=mock
ALLIRA_RUN_TIMEOUT_SECONDS=180
ALLIRA_MAX_PROMPT_CHARACTERS=120000
ALLIRA_MAX_OUTPUT_CHARACTERS=60000
ALLIRA_MAX_CONCURRENT_RUNS=8
ALLIRA_RUN_RATE_PER_MINUTE=20
# Mock-only delay makes cancel/replay browser tests observable.
ALLIRA_MOCK_CHUNK_DELAY_SECONDS=0.3
ALLIRA_CONTEXT_RECENT_TURNS=8
ALLIRA_SUMMARY_MAX_CHARACTERS=6000
# Test energy is integer application credit, NOT money or upstream token usage.
ALLIRA_INITIAL_ENERGY=100
ALLIRA_ECONOMY_ENERGY_COST=1
ALLIRA_FAST_ENERGY_COST=2
ALLIRA_FALLBACK_TO_ECONOMY=true
# Empty by default: configurable string filtering is not a moderation/compliance service.
ALLIRA_SAFETY_BLOCKED_TERMS=[]
ALLIRA_CONSOLE_ENABLED=true
ALLIRA_CONSOLE_DIST_PATH=/opt/allira/workspace/apps/dev-console/dist
ALLIRA_ADMIN_ENABLED=true
# Access is mandatory for deployed administration; old one-time links are disabled.
ALLIRA_ADMIN_AUTH_BACKEND=access
ALLIRA_ADMIN_SESSION_TTL_SECONDS=3600
# Complete all four together in protected /etc/allira/access.env, not browser input.
# ALLIRA_ADMIN_PUBLIC_ORIGIN=https://dsah.guyufl.cc.cd
# ALLIRA_ACCESS_TEAM_DOMAIN=https://guyufl.cloudflareaccess.com
# ALLIRA_ACCESS_AUDIENCE=the-64-character-audience-of-this-exact-access-application
# ALLIRA_ACCESS_ALLOWED_EMAILS=["the-confirmed-administrator@example.com"]
# Link mode and its TTL are only explicit loopback legacy fixtures; never public fallback.

# Optional protected /etc/allira/test-provider.env overrides dev.env for the service.
# Keep real values only there. Never commit it, send it to the browser or print it.
# ALLIRA_PROVIDER=openai
# ALLIRA_UPSTREAM_BASE_URL=https://your-relay.example/v1
# ALLIRA_UPSTREAM_MODEL=your-model-name
# ALLIRA_UPSTREAM_API_KEY=configure-only-in-a-protected-server-environment
# ALLIRA_UPSTREAM_MAX_TOKENS=256
# ALLIRA_MOCK_CHUNK_DELAY_SECONDS=0
# Optional separate fast route. If absent/early failure, configured fallback uses economy.
# ALLIRA_FAST_UPSTREAM_BASE_URL=https://your-fast-relay.example/v1
# ALLIRA_FAST_UPSTREAM_MODEL=your-fast-model-name
# ALLIRA_FAST_UPSTREAM_API_KEY=configure-only-in-a-protected-server-environment

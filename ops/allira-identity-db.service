# Private dependency of Logto OSS. Not a second Allira API process.
[Unit]
Description=AlliraAi identity PostgreSQL (private loopback)
After=network.target

[Service]
Type=simple
User=allira
Group=allira
WorkingDirectory=/var/lib/allira/postgresql
Environment=LD_LIBRARY_PATH=/var/lib/allira/postgresql/runtime/usr/lib/x86_64-linux-gnu
Environment=LC_ALL=C.UTF-8
ExecStart=/var/lib/allira/postgresql/runtime/usr/lib/postgresql/17/bin/postgres -D /var/lib/allira/postgresql/data
Restart=on-failure
RestartSec=3
TimeoutStopSec=60
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/allira/postgresql
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target

# Development only. A formal production login must replace dev/session before public use.
[Unit]
Description=AlliraAi isolated development API (loopback only)
After=network.target

[Service]
Type=simple
User=allira
Group=allira
WorkingDirectory=/opt/allira/workspace/server
EnvironmentFile=/etc/allira/dev.env
ExecStart=/opt/allira/workspace/server/.venv/bin/uvicorn allira.app:create_app --factory --host 127.0.0.1 --port 8000 --workers 1 --no-access-log
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/allira
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
